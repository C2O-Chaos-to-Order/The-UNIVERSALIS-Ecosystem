{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universalis.local/scaffold/schemas/requirement_record.schema.json",
  "title": "Requirement record",
  "description": "One requirement for one research card. requirement_id uses ULC-<tablet>-<clause>. The classification property is requirement disposition, not release classification. evidence_status and authorization_status are separate columns.",
  "type": "object",
  "required": [
    "requirement_id",
    "objective_question",
    "candidate_requirement",
    "research_record_id",
    "simulation_record_id",
    "clause_id",
    "classification",
    "implementation",
    "production_validation",
    "evidence_status",
    "authorization_status",
    "programme_credit",
    "release_classification"
  ],
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^ULC-[0-9]{2}-[0-9]{2}$"},
    "objective_question": {"type": "string", "minLength": 1},
    "candidate_requirement": {"type": "string", "minLength": 1},
    "research_record_id": {"type": "string", "pattern": "^RES-[0-9]{3,}$"},
    "simulation_record_id": {"type": "string", "pattern": "^SIM-[0-9]{3,}$"},
    "clause_id": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "implementation": {"type": "string", "minLength": 1},
    "production_validation": {"type": "string", "minLength": 1},
    "evidence_status": {
      "enum": ["proposed", "documented", "implemented", "tested", "verified", "independently_reproduced", "validated", "authorized"]
    },
    "authorization_status": {"enum": ["NOT_AUTHORIZED", "AUTHORIZED"]},
    "programme_credit": {"enum": ["NONE", "CANDIDATE_PENDING_OWNER_REVIEW", "AWARDED"]},
    "release_classification": {"enum": ["INTERNAL_CANDIDATE", "PUBLICLY_CLEARED"]}
  },
  "additionalProperties": false
}
