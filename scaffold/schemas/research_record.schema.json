{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universalis.local/scaffold/schemas/research_record.schema.json",
  "title": "Research evidence record",
  "description": "One research pass. Field names are the governing Plan evidence-record contract. evidence_status and authorization_status are separate required columns. authorization_status is not derived from evidence_status. This record does not award programme credit by existing.",
  "type": "object",
  "required": [
    "record_id",
    "programme_unit_id",
    "pass_type",
    "checkpoint_id",
    "objective_question",
    "claim_class",
    "relevant_dimensions",
    "phase",
    "level",
    "method_summary",
    "sources_or_inputs",
    "assumptions",
    "acceptance_or_falsification_criteria",
    "actual_conditions",
    "outcome_summary",
    "raw_evidence_location",
    "uncertainty_and_limitations",
    "review_note",
    "evidence_status",
    "authorization_status",
    "regression_links",
    "open_obligations",
    "simulation_link",
    "programme_credit",
    "clause_ids",
    "release_classification"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^RES-[0-9]{3,}$"},
    "programme_unit_id": {"type": "string", "minLength": 1},
    "pass_type": {"const": "research"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "objective_question": {"type": "string", "minLength": 1},
    "claim_class": {"type": "string", "minLength": 1},
    "relevant_dimensions": {"type": "string"},
    "phase": {"type": "string", "minLength": 1},
    "level": {"type": "string", "minLength": 1},
    "method_summary": {"type": "string", "minLength": 1},
    "sources_or_inputs": {"type": "string", "minLength": 1},
    "assumptions": {"type": "string", "minLength": 1},
    "acceptance_or_falsification_criteria": {"type": "string", "minLength": 1},
    "actual_conditions": {"type": "string", "minLength": 1},
    "outcome_summary": {"type": "string", "minLength": 1},
    "raw_evidence_location": {"type": "string", "minLength": 1},
    "uncertainty_and_limitations": {"type": "string", "minLength": 1},
    "review_note": {"type": "string", "minLength": 1},
    "evidence_status": {
      "enum": ["planned", "executed", "failed", "incomplete", "reproduced", "reviewed", "accepted", "authorized"]
    },
    "authorization_status": {"enum": ["NOT_AUTHORIZED", "AUTHORIZED"]},
    "regression_links": {"type": "string"},
    "open_obligations": {"type": "string"},
    "simulation_link": {"type": "string", "pattern": "^SIM-[0-9]{3,}$"},
    "programme_credit": {"enum": ["NONE", "CANDIDATE_PENDING_OWNER_REVIEW", "AWARDED"]},
    "clause_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "release_classification": {"const": "PUBLICLY_CLEARED"}
  }
}
