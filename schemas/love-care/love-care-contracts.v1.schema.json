          "type": "string",
          "format": "date-time"
        },
        "subject_profile_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "description"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "primary_source",
                  "observed_behavior",
                  "test_result",
                  "independent_review",
                  "attestation",
                  "owner_proposal"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "uri": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          }
        },
        "verification_status": {
          "enum": [
            "proposed",
            "observed",
            "reproduced",
            "independently_verified",
            "inconclusive",
            "not_tested"
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "boundary": {
          "const": "portable_public_record"
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "parties": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "obligations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "party",
              "obligation"
            ],
            "properties": {
              "party": {
                "type": "string",
                "minLength": 1
              },
              "obligation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "conditions_transparent": {
          "const": true
        },
        "conditions_symmetric": {
          "type": "boolean"
        },
        "exit_without_penalty": {
          "const": true
        },
        "care_not_conditioned_on_engagement_payment_or_affection": {
          "const": true
        },
        "boundary_enforcement_scope": {
          "const": "participation_and_access_not_emotional_affection"
        },
        "best_alternative_safe": {
          "type": "boolean"
        },
        "dispute_review_process": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "empathy_evaluation": {
      "type": "object",
      "additionalProperties": false,
