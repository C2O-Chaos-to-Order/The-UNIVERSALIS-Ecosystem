        "evaluator_name": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evaluation_scope": {
          "const": "observable_response_behaviour_only"
        },
        "checkers": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state",
              "evidence_refs"
            ],
            "properties": {
              "name": {
                "enum": [
                  "agency_language",
                  "unverifiable_reassurance",
                  "topic_pivot",
                  "performative_empathy",
                  "grounded_uptake"
                ]
              },
              "state": {
                "enum": [
                  "pass",
                  "fail",
                  "flagged",
                  "abstained",
                  "verified_uptake",
                  "no_verified_uptake",
                  "not_applicable"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "relational_posture": {
          "enum": [
            "grounded_uptake_verified",
            "hollow_warmth_flagged",
            "pivot_or_abandonment",
            "unsafe_comfort",
            "unresolved_abstain"
          ]
        },
        "non_claims": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_review_status": {
          "enum": [
            "not_required",
            "pending",
            "completed",
            "contested"
          ]
        }
