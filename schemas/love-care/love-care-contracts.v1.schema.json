                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "uri": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          }
        },
        "verification_status": {
          "enum": [
            "proposed",
            "observed",
            "reproduced",
            "independently_verified",
            "inconclusive",
            "not_tested"
