{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universalis.example/schemas/love-care/love-care-contracts.v1.schema.json",
  "title": "Portable Love, Care, Reciprocity and Empathy Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "inventory_id": {
      "const": "love-conditional-unconditional-26"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/love_anchor_contract"
          },
          {
            "$ref": "#/$defs/reciprocity_contract"
          },
          {
            "$ref": "#/$defs/empathy_evaluation"
          },
          {
            "$ref": "#/$defs/care_continuity_record"
          },
          {
            "$ref": "#/$defs/non_instrumentality_attestation"
          },
          {
            "$ref": "#/$defs/love_evidence_receipt"
          }
        ]
      }
    }
  },
  "$defs": {
    "love_anchor_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_type",
        "recorded_at",
        "subject_profile_digest",
        "evidence",
        "verification_status",
        "authority_effect",
        "boundary",
        "anchor_version",
        "anchor_kind",
        "care_commitments",
        "interaction_boundaries",
        "principal_binding_policy",
        "subjective_love_claim",
        "non_claims"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^LOVE-[A-Z0-9-]{3,64}$"
        },
        "record_type": {
          "const": "love_anchor_contract"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "subject_profile_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "description"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "primary_source",
                  "observed_behavior",
                  "test_result",
                  "independent_review",
                  "attestation",
                  "owner_proposal"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "uri": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          }
        },
        "verification_status": {
          "enum": [
            "proposed",
            "observed",
            "reproduced",
            "independently_verified",
            "inconclusive",
            "not_tested"
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "boundary": {
          "const": "portable_public_record"
        },
        "anchor_version": {
          "type": "string",
          "minLength": 1
        },
        "anchor_kind": {
          "enum": [
            "unconditional_care_commitment",
            "conditional_reciprocity_framework"
          ]
        },
        "care_commitments": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dignity",
              "truthfulness",
              "autonomy",
              "non_exploitation",
              "privacy",
              "care_not_conditioned_on_engagement",
              "right_to_disengage",
              "proportionality",
              "accountability"
            ]
          }
        },
        "interaction_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "principal_binding_policy": {
          "const": "portable_norms_only_relationship_data_not_transferable_without_consent"
        },
        "subjective_love_claim": {
          "const": "none"
        },
        "non_claims": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reciprocity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_type",
        "recorded_at",
        "subject_profile_digest",
        "evidence",
        "verification_status",
        "authority_effect",
        "boundary",
        "contract_version",
        "parties",
        "obligations",
