{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2o-universalis:architecture-graph:1.0.0",
  "title": "Portable Architecture and Dependency Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "snapshot_ref",
    "captured_at",
    "scope",
    "nodes",
    "edges",
    "matrices",
    "proposals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "scope_id",
        "visibility"
      ],
      "properties": {
        "ecosystem": {
          "enum": [
            "c2o",
            "universalis",
            "shared"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "sanitized"
          ]
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_type",
          "label",
          "visibility",
          "authority_class",
          "evidence_state",
          "source_refs"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "enum": [
              "repository",
              "package",
              "module",
              "service",
              "agent",
              "skill",
              "capability",
              "workflow",
              "tool",
              "interface",
              "data_store",
              "policy",
              "hardware",
              "organization",
              "human_reference",
              "model",
              "measurement",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "secret"
            ]
          },
          "authority_class": {
            "enum": [
              "Evidence",
              "Advisory",
              "Controlled"
            ]
          },
          "evidence_state": {
            "enum": [
              "proposed",
              "documented",
              "implemented",
              "tested",
              "verified",
              "unverified",
              "failed",
              "unresolved"
            ]
          },
          "owner_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "policy_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from_node",
          "to_node",
          "relation",
          "evidence_state",
          "source_refs"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "from_node": {
            "type": "string",
            "minLength": 1
          },
          "to_node": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "contains",
              "depends_on",
              "calls",
              "owns",
              "exposes",
              "delegates_to",
              "governed_by",
              "produces",
              "consumes",
              "observes",
              "maps_to",
              "proposes",
              "supersedes",
              "reviews",
              "attests",
              "routes_to",
              "other"
            ]
          },
          "evidence_state": {
            "enum": [
              "proposed",
              "documented",
              "implemented",
              "tested",
              "verified",
              "unverified",
              "failed",
              "unresolved"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "matrices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matrix_id",
          "metric",
          "unit",
          "entries",
          "source_refs"
        ],
        "properties": {
          "matrix_id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject_node",
                "value",
                "observed_at"
              ],
              "properties": {
                "subject_node": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "uncertainty": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "status",
          "proposed_by",
          "change_refs"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "under_review",
              "accepted",
              "rejected",
              "superseded"
            ]
          },
          "proposed_by": {
            "type": "string",
            "minLength": 1
          },
          "change_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "decided_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
