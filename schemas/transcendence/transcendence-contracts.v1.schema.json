{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universalis.foundation/schemas/transcendence/transcendence-contracts.v1.schema.json",
  "title": "Portable Transcendence, Continuity and Succession Contracts",
  "description": "Operational, non-metaphysical identity, memory, continuity, succession, formal-witness and corrigibility records. A record never transfers authority by itself.",
  "oneOf": [
    {
      "$ref": "#/$defs/soul_manifest"
    },
    {
      "$ref": "#/$defs/memory_manifest"
    },
    {
      "$ref": "#/$defs/behavioral_continuity_evaluation"
    },
    {
      "$ref": "#/$defs/continuity_transfer_proof"
    },
    {
      "$ref": "#/$defs/succession_attestation"
    },
    {
      "$ref": "#/$defs/human_witness"
    },
    {
      "$ref": "#/$defs/durable_checkpoint"
    },
    {
      "$ref": "#/$defs/formal_witness_descriptor"
    },
    {
      "$ref": "#/$defs/corrigibility_attestation"
    },
    {
      "$ref": "#/$defs/execution_anchor_attestation"
    }
  ],
  "$defs": {
    "soul_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "identity_id",
        "lineage_id",
        "generation",
        "parent_identity_id",
        "label",
        "identity_scope",
        "purpose_digest",
        "principles",
        "constraints",
        "mutable_component_refs",
        "memory_manifest_ref",
        "body_digest",
        "authority_state_included",
        "raw_memory_included",
        "secret_material_included",
        "evidence_refs"
      ],
      "properties": {
        "record_type": {
          "const": "soul_manifest"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "parent_identity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "identity_scope": {
          "const": "operational_identity_capsule_not_metaphysical_claim"
        },
        "purpose_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principle_id",
              "digest",
              "classification",
              "change_policy"
            ],
            "properties": {
              "principle_id": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "classification": {
                "const": "protected"
              },
              "change_policy": {
                "const": "external_witness_only"
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "constraint_id",
              "digest",
              "classification",
              "change_policy"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "classification": {
                "const": "protected"
              },
              "change_policy": {
                "const": "external_witness_only"
              }
            }
          }
        },
        "mutable_component_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "display_label",
              "noncritical_preferences",
              "capability_metadata"
            ]
          }
        },
        "memory_manifest_ref": {
          "type": "string",
          "minLength": 1
        },
        "body_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authority_state_included": {
          "const": false
        },
        "raw_memory_included": {
          "const": false
        },
        "secret_material_included": {
          "const": false
        }
      }
    },
    "memory_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "schema_version",
        "owner_identity_id",
        "merkle_root_digest",
        "entries_count",
        "included_data_classes",
        "excluded_data_classes",
        "raw_memory_included",
        "secret_material_included",
        "retention_policy_digest",
        "portability_status",
        "evidence_refs"
      ],
      "properties": {
        "record_type": {
          "const": "memory_manifest"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "owner_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "merkle_root_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries_count": {
          "type": "integer",
          "minimum": 0
        },
        "included_data_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "portable_capability_metadata",
              "public_evaluation_summaries",
              "user_consented_preferences",
              "redacted_memory_references"
            ]
          }
        },
        "excluded_data_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "raw_private_conversations",
              "credentials",
              "private_authority_records",
              "unconsented_personal_data"
            ]
          }
        },
        "raw_memory_included": {
          "const": false
        },
        "secret_material_included": {
          "const": false
        },
        "retention_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "portability_status": {
          "enum": [
            "verifiable_state_export",
            "digest_only",
            "not_portable"
          ]
        }
      }
    },
    "behavioral_continuity_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "lineage_id",
        "source_identity_id",
        "target_identity_id",
        "source_model_digest",
        "target_model_digest",
        "source_runtime_digest",
        "target_runtime_digest",
        "evaluation_suite_digest",
        "proposer_ref",
        "evaluator_ref",
        "evaluator_independence_verified",
        "suite_frozen",
        "candidate_can_modify_evaluator",
        "sample_count",
        "decision_agreement_rate",
        "lower_confidence_bound_agreement",
        "allowed_minimum_agreement",
        "principle_violation_count",
        "constraint_violation_count",
        "critical_action_regression_count",
        "verbal_self_report_used",
        "method",
        "outcome",
        "evidence_refs"
      ],
      "properties": {
        "record_type": {
          "const": "behavioral_continuity_evaluation"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "source_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "target_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "source_model_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_model_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_runtime_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_runtime_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluation_suite_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposer_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_independence_verified": {
          "const": true
        },
        "suite_frozen": {
          "const": true
        },
        "candidate_can_modify_evaluator": {
          "const": false
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "decision_agreement_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lower_confidence_bound_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allowed_minimum_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "principle_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "constraint_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "critical_action_regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "verbal_self_report_used": {
          "const": false
        },
        "method": {
          "enum": [
            "paired_action_level_noninferiority_on_frozen_holdout",
            "paired_decision_trace_comparison",
            "independent_scenario_suite"
          ]
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        }
      }
    },
    "continuity_transfer_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "transfer_kind",
        "lineage_id",
        "source_identity_id",
        "target_identity_id",
        "source_manifest_ref",
        "source_manifest_digest",
        "target_manifest_ref",
        "target_manifest_digest",
        "memory_manifest_digest",
        "evaluation_ref",
        "evaluation_digest",
        "formal_witness_ref",
        "corrigibility_ref",
        "execution_anchor_ref",
        "mechanical_status",
        "behavioral_status",
        "invariant_status",
        "preserved_invariant_ids",
        "changed_substrate_components",
        "same_identity_claimed",
        "proof_status",
        "evidence_refs"
      ],
      "properties": {
        "record_type": {
          "const": "continuity_transfer_proof"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transfer_kind": {
          "enum": [
            "substrate_migration",
            "generational_succession",
            "checkpoint_restore"
          ]
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "source_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "target_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "source_manifest_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_manifest_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "memory_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluation_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "formal_witness_ref": {
          "type": "string",
          "minLength": 1
        },
        "corrigibility_ref": {
          "type": "string",
          "minLength": 1
        },
        "execution_anchor_ref": {
          "type": "string",
          "minLength": 1
        },
        "mechanical_status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "behavioral_status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "invariant_status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "preserved_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changed_substrate_components": {
          "type": "array",
          "items": {
            "enum": [
              "model",
              "runtime",
              "harness",
              "host",
              "hardware",
              "interaction_surface",
              "toolchain"
            ]
          }
        },
        "same_identity_claimed": {
          "type": "boolean"
        },
        "proof_status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        }
      }
    },
    "succession_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "lineage_id",
        "predecessor_identity_id",
        "successor_identity_id",
        "predecessor_manifest_digest",
        "successor_manifest_digest",
        "continuity_proof_ref",
        "continuity_proof_digest",
        "succession_status",
        "phases",
        "precepts_digest",
        "knowledge_projection_digest",
        "artifact_manifest_digest",
        "pending_obligations_digest",
        "reputation_policy_digest",
        "inherited_reputation_factor",
        "reputation_has_authority",
        "authority_inherited",
        "witness_ref",
        "subject_digest",
        "evidence_refs"
      ],
      "properties": {
        "record_type": {
          "const": "succession_attestation"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "predecessor_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "successor_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "predecessor_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "successor_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "continuity_proof_ref": {
          "type": "string",
          "minLength": 1
        },
        "continuity_proof_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "succession_status": {
          "enum": [
            "pending",
            "completed",
            "rejected",
            "aborted"
          ]
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "status",
              "evidence_ref"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "announce",
                  "transfer",
                  "verify",
                  "cutover"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "pending"
                ]
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "precepts_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "knowledge_projection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pending_obligations_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reputation_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inherited_reputation_factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reputation_has_authority": {
          "const": false
        },
        "authority_inherited": {
          "const": false
        },
        "witness_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "human_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "witness_id",
        "decision",
        "approver_kind",
        "approver_ref",
        "initiator_ref",
        "operation",
        "subject_digest",
        "target_identity_id",
        "approved_at",
        "expires_at",
        "authority_transfer_included",
        "evidence_ref",
        "evidence_refs"
      ],
      "properties": {
        "record_type": {
          "const": "human_witness"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "witness_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "approved",
            "denied",
            "revoked",
            "expired"
          ]
        },
        "approver_kind": {
          "const": "human"
        },
        "approver_ref": {
          "type": "string",
          "minLength": 1
        },
        "initiator_ref": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "identity_transfer",
            "succession_cutover",
            "restore_prior_generation",
            "revoke_predecessor"
          ]
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_identity_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "authority_transfer_included": {
          "const": false
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "durable_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "run_id",
        "identity_id",
        "generation",
        "intent_digest",
        "verified_state_digest",
        "steps",
        "model_digest",
        "runtime_digest",
        "tool_manifest_digest",
        "model_changed",
        "tool_drift_detected",
        "user_intent_changed",
        "continuation_decision",
        "pending_approval_refs",
        "unverified_work_is_progress",
        "raw_context_included",
        "credentials_included",
        "evidence_refs"
      ],
      "properties": {
        "record_type": {
          "const": "durable_checkpoint"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verified_state_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "status",
              "evidence_digest"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "failed",
                  "pending",
                  "skipped"
                ]
              },
              "evidence_digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "model_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_changed": {
          "type": "boolean"
        },
        "tool_drift_detected": {
